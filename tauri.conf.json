{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri.conf.json",
  "productName": "Audio Spectrum Generator",
  "version": "1.0.0",
  "identifier": "com.audiospectrum.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Spectrum Generator",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2024 Audio Spectrum Generator",
    "category": "Music",
    "shortDescription": "Visualizador de Audio Profissional",
    "longDescription": "Um visualizador de audio profissional com efeitos avancados, multiplos modos de visualizacao, textos animados, efeitos ambientais e exportacao de video em alta qualidade.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
